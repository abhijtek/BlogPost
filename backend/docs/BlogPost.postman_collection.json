              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/blogs/posts/pending",
              "host": ["{{baseUrl}}"],
              "path": ["blogs", "posts", "pending"]
            }
          }
        },
        {
          "name": "Approve Pending Post Admin",
          "request": {
            "auth": {
              "type": "bearer",
