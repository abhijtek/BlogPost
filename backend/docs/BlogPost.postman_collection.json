            },
            "url": {
              "raw": "{{baseUrl}}/blogs/posts/{{slug}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["blogs", "posts", "{{slug}}", "review"]
            }
          }
        },
        {
          "name": "Reject Pending Post Admin",
